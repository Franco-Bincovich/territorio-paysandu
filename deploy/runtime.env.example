# Copy OUTSIDE the repository. Never store real secrets in this template.
# Production mode requires all of these explicit flags and a fixed HTTPS origin.
AUTH_PROVIDER=mariadb
MARIADB_ENABLED=false
APP_ORIGIN=https://territorio.example.invalid
MARIADB_DATABASE=auxiliares
MARIADB_HOST=
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_TLS=true
# Optional internal CA, mounted via compose.tls.yaml:
# MARIADB_TLS_CA_FILE=/run/territorio-ca/auxiliares-ca.pem
INSTITUTIONAL_ENABLED=false
INSTITUTIONAL_HOST=
INSTITUTIONAL_PORT=3306
INSTITUTIONAL_DATABASE=
INSTITUTIONAL_USER=
INSTITUTIONAL_PASSWORD=
INSTITUTIONAL_TLS=true
# INSTITUTIONAL_TLS_CA_FILE=/run/territorio-ca/institutional-ca.pem
CONSULTATIONS_WRITE_ENABLED=false
# Required production security coordinator, provisioned externally. No local fallback.
SECURITY_REDIS_HOST=
SECURITY_REDIS_PORT=6380
SECURITY_REDIS_USER=
SECURITY_REDIS_PASSWORD=
SECURITY_REDIS_TLS=true
# SECURITY_REDIS_CA_FILE=/run/territorio-ca/redis-ca.pem
SECURITY_PROXY_SECRET=
# Optional backend SFTP provider, enable only after independent host-key verification.
# IMAGE_PROVIDER=sftp
SFTP_IMAGES_ENABLED=false
SFTP_IMAGES_HOST=
SFTP_IMAGES_PORT=22
SFTP_IMAGES_USER=sftp-lectura
SFTP_IMAGES_PASSWORD=
SFTP_IMAGES_HOST_KEY_SHA256=
SFTP_IMAGES_HOST_KEY_VERIFIED=false
SFTP_IMAGES_TIMEOUT_MS=10000
SFTP_IMAGES_MAX_BYTES=10485760
SFTP_IMAGES_MAX_ENTRIES=10000
SFTP_IMAGES_HISTORICAL_DIRECTORY=/Satelitales
SFTP_IMAGES_SURVEY_DIRECTORY=/PDFs
SFTP_IMAGES_SURVEY_MAPPING_CONFIRMED=false
SFTP_IMAGES_SURVEY_BASENAME=
