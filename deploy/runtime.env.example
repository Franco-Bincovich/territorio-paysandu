# Copy OUTSIDE the repository. Never store real secrets in this template.
# Production mode requires all of these explicit flags and a fixed HTTPS origin.
AUTH_PROVIDER=mariadb
MARIADB_ENABLED=false
APP_ORIGIN=https://territorio.example.invalid
MARIADB_DATABASE=auxiliares
MARIADB_HOST=
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_TLS=true
# Optional internal CA, mounted via compose.tls.yaml:
# MARIADB_TLS_CA_FILE=/run/territorio-ca/auxiliares-ca.pem
INSTITUTIONAL_ENABLED=false
INSTITUTIONAL_HOST=
INSTITUTIONAL_PORT=3306
INSTITUTIONAL_DATABASE=
INSTITUTIONAL_USER=
INSTITUTIONAL_PASSWORD=
INSTITUTIONAL_TLS=true
# INSTITUTIONAL_TLS_CA_FILE=/run/territorio-ca/institutional-ca.pem
CONSULTATIONS_WRITE_ENABLED=false
# Institutional image server integration is pending; no fabricated provider.
