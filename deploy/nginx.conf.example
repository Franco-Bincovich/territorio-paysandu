# Plantilla para Nginx en el MISMO host que Docker (contexto http).
# Sustituir dominio y rutas; no cargar antes de completar certificados y secreto.
server {
    listen 80 default_server;
    server_name _;
    access_log off;
    return 444;
}
server {
    listen 80;
    server_name territorio.example.invalid;
    access_log off;
    return 308 https://territorio.example.invalid$request_uri;
}
server {
    listen 443 ssl;
    server_name territorio.example.invalid;
    ssl_certificate /RUTA_REAL/fullchain.pem;
    ssl_certificate_key /RUTA_PRIVADA/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Fuera del repositorio: proxy_set_header X-TP-Proxy-Token "SECRETO_REAL";
    # Usar el mismo SECURITY_PROXY_SECRET; escapar según sintaxis Nginx.
    access_log off;
    error_log /var/log/nginx/territorio-error.log crit;
    client_max_body_size 64k;
    client_body_timeout 10s;
    if ($host != territorio.example.invalid) { return 444; }
    location / {
        # Mismo nivel que los otros proxy_set_header: Nginx no los fusiona
        # con los de server si location define cualquiera de ellos.
        include /RUTA_PRIVADA/territorio-proxy-secret.conf;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host territorio.example.invalid;
        proxy_set_header X-Forwarded-Host territorio.example.invalid;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-TP-Client-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_cache off;
    }
}
