# Copiar a Backend/server/institutional/.env.local. Nunca subir credenciales.
INSTITUTIONAL_ENABLED=false
INSTITUTIONAL_HOST=
INSTITUTIONAL_PORT=3306
INSTITUTIONAL_DATABASE=
INSTITUTIONAL_USER=
INSTITUTIONAL_PASSWORD=
INSTITUTIONAL_TLS=true
INSTITUTIONAL_TLS_CA_FILE=
# Optional: enable institutional notification lots for administrators in the local dev launcher.
NOTIFICATION_LOTS_LOCAL_INSTITUTIONAL=false
