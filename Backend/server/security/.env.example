# Private backend variables only. Required for production; never NEXT_PUBLIC_*.
# Redis external: provision separately, dedicated ACL, TLS, persistence, noeviction.
SECURITY_REDIS_HOST=
SECURITY_REDIS_PORT=6380
SECURITY_REDIS_USER=
SECURITY_REDIS_PASSWORD=
SECURITY_REDIS_TLS=true
SECURITY_REDIS_CA_FILE=
# Random >=32-character value shared ONLY with the same-host reverse proxy.
# Proxy overwrites X-TP-Proxy-Token and X-TP-Client-IP (one canonical IP).
SECURITY_PROXY_SECRET=
