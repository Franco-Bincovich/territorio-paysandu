# Local private file: Backend/server/sftp-images/.env.local (ignored by Git).
IMAGE_PROVIDER=sftp
SFTP_IMAGES_ENABLED=false
SFTP_IMAGES_HOST=
SFTP_IMAGES_PORT=22
SFTP_IMAGES_USER=sftp-lectura
SFTP_IMAGES_PASSWORD=
# Alternatively, use only a private key file (not password):
SFTP_IMAGES_PRIVATE_KEY_FILE=
SFTP_IMAGES_PRIVATE_KEY_PASSPHRASE=
SFTP_IMAGES_HOST_KEY_SHA256=
# true ONLY after independent infrastructure verification of the fingerprint.
SFTP_IMAGES_HOST_KEY_VERIFIED=false
SFTP_IMAGES_TIMEOUT_MS=10000
SFTP_IMAGES_MAX_BYTES=10485760
SFTP_IMAGES_MAX_ENTRIES=10000
SFTP_IMAGES_HISTORICAL_DIRECTORY=/Satelitales/IMAGENES_HISTORICAS
SFTP_IMAGES_SURVEY_DIRECTORY=/Satelitales/IMAGENES_ACTUALES
# Historical: YEAR_LOCALITY_PARCEL[_SUFFIX].png (never PadCod in filename).
# Survey: parcela_PARCEL_LOCALITY.png, never PadCod. Exact match; multiple candidates rejected.
SFTP_IMAGES_SURVEY_EXTENSIONS=png
