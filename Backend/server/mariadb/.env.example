# Copiar solo estas opciones al .env.local de un proceso local de pruebas.
# No usar NEXT_PUBLIC_ ni subir secretos. Supabase es el valor predeterminado.
AUTH_PROVIDER=supabase
MARIADB_AUTH_TEST_ENABLED=false
APP_ORIGIN=http://127.0.0.1:3105
DATA_MODE=synthetic
MARIADB_HOST=
MARIADB_PORT=3306
MARIADB_DATABASE=auxiliares
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_TLS=true
# CA privada opcional. Mantener verificación de certificado y hostname.
MARIADB_TLS_CA_FILE=
# Habilitar solo después de consultations:check y autorización de prueba web.
CONSULTATIONS_WRITE_ENABLED=true
